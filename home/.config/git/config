[commit]
    gpgsign = true
[gpg]
    format = ssh
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    default = current
    autoSetupRemote = true
[secrets]
    entry = GitHub
    privateKeyField = SSH Private Key
    publicKeyField = SSH Public Key
[tag]
    gpgsign = true
[url "git@github.com:"]
    insteadOf = https://github.com/
[user]
    name = jkemming
    email = git@jkemming.com
