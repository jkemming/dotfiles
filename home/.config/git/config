[commit]
    gpgsign = true
[core]
    sshCommand = ssh -i ~/.ssh/github -o IdentitiesOnly=yes
[gpg]
    format = ssh
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    default = current
    autoSetupRemote = true
[tag]
    gpgsign = true
[url "git@github.com:"]
    insteadOf = https://github.com/
[user]
    name = jkemming
    email = git@jkemming.com
    signingKey = ~/.ssh/github
