#!/usr/bin/env fish
#MISE description="Sync to home directory"
#USAGE flag "--prune" help="Do a full target-tree scan to prune orphaned symlinks left behind by renamed/moved files (slower)"

# Creates `~/.config/git/includes.config` from `*.config` files in `~/.config/git/conf.d/`.
# Each file's first line must declare its scope: `# directory = ~/projects/work/`
function create_git_includes_config --description "Rebuild ~/.config/git/includes.config from conf.d snippets"
    set -l conf_dir "$HOME/.config/git/conf.d"
    set -l out_file "$HOME/.config/git/includes.config"
    mkdir -p (dirname $out_file)

    set -l lines "# Generated by dotfiles repository. Do not edit manually." ""
    set -l count 0

    if test -d $conf_dir
        for f in $conf_dir/*.config
            test -e $f; or continue

            set -l header (head -n1 $f)
            set -l pattern (string match --regex --groups-only '^#\s*directory\s*=\s*(.+)$' -- $header)

            if test -z "$pattern"
                echo "Warning: $f has no '# directory = <pattern>' header, skipping" >&2
                continue
            end

            set lines $lines "[includeIf \"gitdir:$pattern\"]" "    path = $f" ""
            set count (math $count + 1)
        end
    end

    printf '%s\n' $lines > $out_file
    echo "Generated includes for $count files in $out_file"
end

set stow_extra_args
if test "$usage_prune" = "true"
    echo "Note: Pruning does not clean up empty directories after symlinks are removed"
    set stow_extra_args --compat
end

stow --restow --verbose --no-folding --target="$HOME" $stow_extra_args .
create_git_includes_config
